modules = ["nodejs-24", "python-base-3.13"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"

[userenv]

[userenv.shared]
GRAFANA_MCP_URL = "https://giantthyme1621.grafana.net/api/mcp"
GRAFANA_MCP_ARGS_JSON = "[\"mcp-grafana\"]"
GRAFANA_MCP_COMMAND = "uvx"
GRAFANA_MCP_TRANSPORT = "stdio"
GRAFANA_URL = "https://giantthyme1621.grafana.net"
GRAFANA_MAX_TOOL_ROUNDS = "8"
